{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    },
    "penpot": {
      "type": "local",
      "command": ["npx", "penpot-mcp-server"],
      "enabled": true,
      "environment": {
        "PENPOT_ACCESS_TOKEN": "{env:PENPOT_ACCESS_TOKEN}",
        "PENPOT_BASE_URL": "{env:PENPOT_BASE_URL}"
      }
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres"],
      "enabled": true,
      "environment": {
        "POSTGRES_URL": "{env:POSTGRES_URL}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "enabled": true,
      "oauth": {}
    }
  },
  "tools": {
    "playwright_*": false,
    "penpot_*": false,
    "github_*": false,
    "postgres_*": false,
    "context7_*": false,
    "sentry_*": false
  }
}
