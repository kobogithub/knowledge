{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/kobo/github/knowledge"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  },
  "workspace": {
    "name": "knowledge",
    "type": "rust-cli",
    "rootPath": "/home/kobo/github/knowledge",
    "beadsEnabled": true,
    "beadsPath": "/home/kobo/github/knowledge/.beads"
  }
}
