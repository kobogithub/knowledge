# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, read:org, read:user
# Used by: Planner, Backend, DevOps, QA, Security agents (GitHub MCP)
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
GITHUB_TOKEN=your_github_token_here

# Supabase Access Token
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your_supabase_token_here

# OpenRouter API Key
# Get from: https://openrouter.ai/settings/keys
# Required for all agent LLM calls
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL Connection URL
# Used by: Backend agent (Postgres MCP)
# Format: postgresql://user:password@host:port/database
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/knowledge

# Penpot Design Tool
# Used by: Frontend, UI/UX Tester agents (Penpot MCP)
# Get from: Penpot account settings
PENPOT_ACCESS_TOKEN=your_penpot_token_here
PENPOT_BASE_URL=https://design.penpot.app
